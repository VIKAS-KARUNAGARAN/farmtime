# FarmTime API configuration. Copy to .env and adjust.
PORT=4000
NODE_ENV=development

# SQLite database file (created and seeded automatically on first run)
DATABASE_FILE=./data/farmtime.db

# Comma-separated list of frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Business time zone used for "today", rosters and pay periods
TZ=Australia/Adelaide

# Demo mode: accepts the fixed MFA code below in addition to real TOTP codes,
# and exposes the seeded TOTP secrets in the server log. Turn OFF in production.
DEMO_MODE=true
DEMO_MFA_CODE=246810

# Set to true when served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false
