# Supabase: Project Settings > Database > Connection string > URI.
# Use the "Session pooler" string (port 5432) for a long-running Express server.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Origins allowed to call the API with cookies (your Next.js site).
CORS_ORIGINS=http://localhost:3000
PORT=4000
TZ=Australia/Adelaide
FARM_NAME=Your farm
# Set to true in production (HTTPS) so the session cookie is Secure.
COOKIE_SECURE=false

# Compliance rule used for break checks (compliance_rules.rule_id). 1 = Standard AU Rule (5 h), 2 = PID Break Rule (4 h).
ACTIVE_RULE_ID=2
# Security settings (v3 has no settings table)
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
ADMIN_IDLE_MINUTES=30
SESSION_HOURS=12
PIN_VALID_HOURS=72
# First day of any fortnightly pay period (a Monday)
PAY_PERIOD_ANCHOR=2026-08-31
HOLIDAY_STATE=SA
# Only on a dev/test database: lets `npm run seed:dev` wipe and reload the DB team's seed
# ALLOW_DEV_SEED=yes
