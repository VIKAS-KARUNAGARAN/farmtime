# Supabase: Project Settings > Database > Connection string > URI.
# Use the "Session pooler" string (port 5432) for a long-running Express server.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Origins allowed to call the API with cookies (your Next.js site).
CORS_ORIGINS=http://localhost:3000
PORT=4000
TZ=Australia/Adelaide
FARM_NAME=Your farm
# Set to true in production (HTTPS) so the session cookie is Secure.
COOKIE_SECURE=false
