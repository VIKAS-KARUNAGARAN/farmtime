{
  "name": "farmtime-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js backend for FarmTime: auth with role-based portals, MFA, clocking, rosters, leave, payroll and audit trail.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js --reset",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
